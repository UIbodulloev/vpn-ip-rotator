#!/bin/bash
# Пульт управления всей системой — с VPN-сервера, без захода на medbot.
#
#   vpnctl status            здоровье обоих серверов, подписки и сторожа
#   vpnctl panel             применить panel/ из репозитория в /opt/panel
#   vpnctl worker            выкатить генератор подписок на Cloudflare и проверить
#   vpnctl bot-test          прогнать тесты бота на medbot (последний коммит в GitHub)
#   vpnctl bot-deploy        выкатить бота на medbot из GitHub (с тестами и откатом)
#   vpnctl bot-rollback      вернуть предыдущую версию бота
#   vpnctl bot-restart       перезапустить бота
#   vpnctl bot-logs [N]      журнал бота
#   vpnctl ship              всё сразу: push → panel → worker (если менялся) → bot-deploy
#
# Источник правды — GitHub (UIbodulloev/vpn-ip-rotator), рабочая копия здесь:
# /root/vpn-ip-rotator. Правило одно: сначала коммит и push, потом выкатка.
# На medbot попадает только то, что лежит в origin/main.
set -euo pipefail

REPO=/root/vpn-ip-rotator
PANEL=/opt/panel
TOKEN_FILE=/root/.config/vpn/cf-deploy-token
SUB_HOST=origin.mos8.online
MIRROR=https://sub.mos8.online:8443
PROBE=00000000-0000-4000-8000-000000000000
MEDBOT=medbot-ops                 # Host в /root/.ssh/config

say()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m /!\\\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m!!!\033[0m %s\n' "$*" >&2; exit 1; }

medbot() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$MEDBOT" "$@"; }

pushed() {
    cd "$REPO"
    [ -z "$(git status --porcelain)" ] || die "в $REPO есть незакоммиченные правки — сначала git commit"
    git fetch -q origin main
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] \
        || die "HEAD не совпадает с origin/main — сначала git pull --rebase / git push"
}

cmd_status() {
    say "VPN-сервер"
    for unit in hysteria-server device-guard sub-mirror p2p-block docker; do
        printf '  %-16s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
    done
    printf '  %-16s %s\n' "3x-ui" "$(docker inspect -f '{{.State.Status}}' 3x-ui 2>/dev/null || echo нет)"
    for c in amnezia-awg2 awg31; do
        printf '  %-16s %s\n' "$c" "$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo нет)"
    done
    free -m | awk '/^Mem/{printf "  память           свободно %s из %s МБ\n",$7,$2} /^Swap/{printf "  своп             занято %s МБ\n",$3}'
    say "сторож устройств"
    "$PANEL/device-guard.py" status 2>&1 | sed 's/^/  /'
    say "сторож здоровья (таймер $(systemctl is-active vpn-watchdog.timer 2>/dev/null || true))"
    "$PANEL/watchdog.py" status 2>&1 | sed 's/^/  /'
    "$PANEL/watchdog.py" events 2>&1 | tail -3 | sed 's/^/  /'
    code=$(curl -s -o /tmp/vpnctl-health.json -w '%{http_code}' --max-time 20 "https://$SUB_HOST/health" || echo 000)
    printf '  списки генератора: HTTP %s, %s\n' "$code" \
        "$(python3 -c 'import json;h=json.load(open("/tmp/vpnctl-health.json"));print("свежие" if h["ok"] else "ЗАПАСНЫЕ", "· доменов", h["domains"]["count"], "· сетей", h["cidr"]["count"], "· заблокированных .ru", h["blocked_ru"])' 2>/dev/null || echo '?')"
    rm -f /tmp/vpnctl-health.json
    say "подписка"
    for base in "https://$SUB_HOST" "$MIRROR"; do
        code=$(curl -s -o /tmp/vpnctl-sub.json -w '%{http_code}' --max-time 15 -A SFA/1.14 "$base/sub/$PROBE" || echo 000)
        marks=$(grep -cE '"no_drop": true|"mtu": 9000' /tmp/vpnctl-sub.json 2>/dev/null || echo 0)
        printf '  %-34s HTTP %s, признаков новой версии %s/2\n' "$base" "$code" "$marks"
    done
    rm -f /tmp/vpnctl-sub.json
    say "бот на medbot"
    medbot status 2>&1 | sed 's/^/  /' || warn "medbot не ответил"
    say "репозиторий $REPO"
    (cd "$REPO" && git fetch -q origin main && git status -sb | head -1 | sed 's/^/  /')
}

# panel/ из репозитория → /opt/panel. Перезапускаем только то, что изменилось
# и чей перезапуск безопасен. hysteria-official.sh и прочие установщики сами
# не запускаем: это разовые операции, их делают осознанно.
cmd_panel() {
    cd "$REPO"
    local changed=() f
    for f in panel/*.py panel/*.sh; do
        [ -f "$f" ] || continue
        if ! cmp -s "$f" "$PANEL/$(basename "$f")"; then
            case "$f" in *.py) python3 -m py_compile "$f" || die "$f не компилируется" ;;
                         *.sh) bash -n "$f" || die "$f с синтаксической ошибкой" ;; esac
            changed+=("$(basename "$f")")
        fi
    done
    [ "${#changed[@]}" -gt 0 ] || { say "panel/ уже совпадает с /opt/panel"; return; }
    for f in "${changed[@]}"; do
        [ -f "$PANEL/$f" ] && cp -a "$PANEL/$f" "$PANEL/$f.prev"
        install -m 0755 "panel/$f" "$PANEL/$f"
        say "обновлён $f"
    done
    for f in "${changed[@]}"; do
        case "$f" in
            device-guard.py)
                systemctl restart device-guard; sleep 2
                systemctl is-active --quiet device-guard || { cp -a "$PANEL/$f.prev" "$PANEL/$f"; systemctl restart device-guard; die "сторож не поднялся — вернул прежний"; }
                say "сторож перезапущен" ;;
            sub-mirror.py)
                systemctl restart sub-mirror; sleep 2
                systemctl is-active --quiet sub-mirror || { cp -a "$PANEL/$f.prev" "$PANEL/$f"; systemctl restart sub-mirror; die "зеркало не поднялось — вернул прежнее"; }
                say "зеркало перезапущено" ;;
        esac
    done
}

cmd_worker() {
    [ -s "$TOKEN_FILE" ] || die "нет токена Cloudflare: положите его в $TOKEN_FILE (см. CLAUDE.md)"
    cd "$REPO/subs"
    CF_DEPLOY_TOKEN="$(cat "$TOKEN_FILE")" ./deploy.sh "$SUB_HOST"
    # Зеркало держит копию час — сбрасываем, чтобы люди получили новое сразу.
    rm -rf /var/cache/sub-mirror/* 2>/dev/null || true
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$MIRROR/sub/$PROBE" || echo 000)
    [ "$code" = 200 ] && say "зеркало отдаёт новую подписку" || warn "зеркало ответило HTTP $code"
}

cmd_ship() {
    cd "$REPO"
    [ -z "$(git status --porcelain)" ] || die "сначала git commit"
    local before; before=$(git rev-parse origin/main)
    git push -q origin HEAD:main
    pushed
    cmd_panel
    if ! git diff --quiet "$before" HEAD -- subs/; then cmd_worker; else say "subs/ не менялся — воркер не трогаю"; fi
    if ! git diff --quiet "$before" HEAD -- rotator/ tests/ requirements.txt; then
        medbot deploy "$(git rev-parse HEAD)"
    else
        say "бот не менялся — medbot не трогаю"
    fi
}

case "${1:-status}" in
    status)       cmd_status ;;
    panel)        pushed; cmd_panel ;;
    worker)       pushed; cmd_worker ;;
    bot-test)     pushed; medbot test "$(git -C "$REPO" rev-parse HEAD)" ;;
    bot-deploy)   pushed; medbot deploy "$(git -C "$REPO" rev-parse HEAD)" ;;
    bot-rollback) medbot rollback ;;
    bot-restart)  medbot restart ;;
    bot-logs)     medbot logs "${2:-80}" ;;
    ship)         cmd_ship ;;
    *) sed -n '2,15p' "$0"; exit 1 ;;
esac
